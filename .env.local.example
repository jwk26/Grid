NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Turnstile. Leave the site key unset to run without the check.
# Cloudflare's public test site keys: always passes 1x00000000000000000000AA,
# always blocks 2x00000000000000000000AB, forces an interactive challenge 3x00000000000000000000FF.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Read by supabase/config.toml: Cloudflare's public test secret that always passes,
# 1x0000000000000000000000000000000AA (always fails: 2x0000000000000000000000000000000AA).
SUPABASE_AUTH_CAPTCHA_SECRET=

# Development OAuth apps (`grid (dev)` GitHub, `grid dev` Google), read by supabase/config.toml.
# The values come from your password manager; never commit them. Callback: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
