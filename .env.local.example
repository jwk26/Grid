NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Turnstile. Leave the site key unset to run without the check.
# Cloudflare's public test site keys: always passes 1x00000000000000000000AA,
# always blocks 2x00000000000000000000AB, forces an interactive challenge 3x00000000000000000000FF.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Read by supabase/config.toml: Cloudflare's public test secret that always passes,
# 1x0000000000000000000000000000000AA (always fails: 2x0000000000000000000000000000000AA).
SUPABASE_AUTH_CAPTCHA_SECRET=

# Development OAuth apps (`grid (dev)` GitHub, `grid dev` Google), read by supabase/config.toml.
# The values come from your password manager; never commit them. Callback: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Account backup (Phase 52). Development values only: .env.local never holds a production
# token or ping URL, since the local cron also runs daily. Values come from your password manager.
# The development R2 bucket `grid-backup-dev` and its bucket-scoped Object Read & Write token.
# Endpoint: https://<cloudflare account id>.r2.cloudflarestorage.com (no bucket in the path).
R2_DEV_ENDPOINT=
R2_DEV_BUCKET=
R2_DEV_ACCESS_KEY_ID=
R2_DEV_SECRET_ACCESS_KEY=
# Backup-only shared secret for the local function and local Vault; any random value
# (for example `openssl rand -hex 32`), never reused in production.
BACKUP_SHARED_SECRET=
# The local stand-in for R2 and the function's own S3 settings: local Supabase Storage's S3
# endpoint as seen from the edge runtime container (key pair from `pnpm exec supabase status -o env`:
# S3_PROTOCOL_ACCESS_KEY_ID / S3_PROTOCOL_ACCESS_KEY_SECRET). Never a production R2 token.
BACKUP_S3_ENDPOINT=http://host.docker.internal:54321/storage/v1/s3
BACKUP_S3_REGION=local
BACKUP_S3_BUCKET=backup
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The function URL as seen from the database container; stored in local Vault for pg_net.
BACKUP_FUNCTION_URL=http://host.docker.internal:54321/functions/v1/backup
# The daily summary's Healthchecks.io ping. Locally it points at the stub the function tests start on
# port 54390 (reached from the edge runtime container through host.docker.internal); never a real
# check URL, since a local run would ping the production check. Restart `supabase functions serve`
# (or `supabase stop && supabase start`) after changing it.
HEALTHCHECKS_DAILY_PING_URL=http://host.docker.internal:54390/ping
